<launch>
    <arg name="robot_name" default="Quadrotor"/>
    <arg name="map_frame" default="map_gt"/>

    <group>
        <push-ros-namespace namespace="$(var robot_name)"/>

        <node
            name="estimator_node"
            pkg="auv_localization"
            exec="estimator"
            output="screen">
            <!-- Declare parameters with default values -->
            <param name="robot_name" value="$(var robot_name)" />
            <param name="map_frame" value="$(var map_frame)" />

            <!-- Camera intrinsic parameters -->
            <param name="f_x" value="368.993" />  <!-- Equivalent to 20.78461 * 640 / 36 -->
            <param name="f_y" value="415.692" />  <!-- Equivalent to 20.78461 * 480 / 24 -->
            <param name="c_x" value="320" />
            <param name="c_y" value="240" />

            <!-- Kalman Filter noise parameters -->
            <param name="Q_noise" value="0.001" />  <!-- 10 ** -3 -->
            <param name="R_noise" value="0.001" />  <!-- 10 ** -3 -->
            <param name="R_noise_depth" value="1e-06" />  <!-- 10 ** -6 -->
            <param name="P_noise" value="0.01" />  <!-- 10 ** -2 -->
         
        </node>

        <node
            name="detector_node"
            pkg="auv_localization"
            exec="detector"
            output="screen">
            <!-- Declare parameters with default values -->
            <param name="robot_name" value="$(var robot_name)" />
        </node>
    </group>
</launch>

