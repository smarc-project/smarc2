<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pad_landing_controller</name>
  <version>0.0.0</version>
  <description>Model-based autonomous landing on pad pipeline</description>
  <maintainer email="ckmc@kth.se">Cristhian Mallqui</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-transforms3d</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <exec_depend>dji_msgs</exec_depend>
  <exec_depend>smarc_msgs</exec_depend>
  <exec_depend>smarc_georef_cpp</exec_depend>
  <exec_depend>smarc_action_base</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
