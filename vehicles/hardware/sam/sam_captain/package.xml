<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sam_captain</name>
  <version>0.0.0</version>
  <description>Interface to SAM for status, nav, and control</description>
  <maintainer email="akira.techap@gmail.com">aki</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>dead_reckoning_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sam_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>smarc_msgs</depend>
  <depend>smarc_utilities</depend>
  <depend>std_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
